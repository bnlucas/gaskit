@@ -0,0 +1,26 @@
+# frozen_string_literal: true
+
+require "castkit"
+require_relative "types/any"
+require_relative "types/symbol"
+
+module Gaskit
+  # Sets up Castkit defaults and registers shared Gaskit-specific types.
+  module Castkit
+    module_function
+
